<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/widget_bg" android:padding="10dp">
<LinearLayout android:id="@+id/widget_content" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Memo" android:textSize="15sp" android:textStyle="bold" android:textColor="#24212A" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="표시할 메모 선택" android:textSize="13sp" android:textColor="#686572" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
<TextView android:id="@+id/widget_add" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="26sp" android:textColor="#7560A8" android:contentDescription="새 메모"/>
<TextView android:id="@+id/widget_settings" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="#686572" android:contentDescription="위젯 설정"/>
</LinearLayout>
